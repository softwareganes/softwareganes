                height: 48px;
            }

            nav .logo {
                font-size: 1.4rem;
                gap: 0.6rem;
            }

            .hero-inner {
                flex-direction: column;
                text-align: center;
            }

            .hero h1 {
                font-size: 2.2rem;
            }

            .hero p {
                font-size: 1.1rem;
            }

            .hero-visual {
                flex-basis: auto;
                width: 100%;
            }

            .hero-buttons {
                justify-content: center;
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }

            .pricing-card.featured {
                transform: scale(1);
            }

            .services-grid {
                grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
                gap: 1rem;
            }

            .service-card {
                padding: 0.9rem;
            }

            .service-icon {
                font-size: 1.8rem;
            }

            .service-card h3 {
                font-size: 1rem;
            }
        }
    </style>
</head>
